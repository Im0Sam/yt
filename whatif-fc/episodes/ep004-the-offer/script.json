 "hook": {
  "line1": "SIGN. RETIRE.",
  "line2": "HE SAID NO.",
  "until": 2.8,
  "pulse_at": 0.35
 },
 "lines": [
  {
   "text": "Sign here. And retire.",
   "caption": "SIGN HERE. AND RETIRE.",
   "hl": [
    "RETIRE"
   ],
   "anchor": 0.38,
   "speed": 1.25
  },
  {
   "text": "He said no.",
   "caption": "HE SAID NO.",
   "hl": [
    "NO"
   ],
   "anchor": 1.5,
   "speed": 1.05
  },
  {
   "text": "Teo's club wanted him as keeper coach.",
   "caption": "TEO'S CLUB WANTED HIM AS KEEPER COACH.",
   "hl": [
    "COACH"
   ],
   "anchor": 2.85,
   "speed": 1.25
  },
  {
   "text": "Every day, next to his son.",
   "caption": "EVERY DAY, NEXT TO HIS SON.",
   "hl": [
    "SON"
   ],
   "anchor": 4.65,
   "speed": 1.2
  },
  {
   "text": "One condition. Hang up the gloves.",
   "caption": "ONE CONDITION. HANG UP THE GLOVES.",
   "hl": [
    "GLOVES"
   ],
   "anchor": 6.45,
   "speed": 1.2
  },
  {
   "text": "He's forty-two. A step slower every week.",
   "caption": "HE'S 42. A STEP SLOWER EVERY WEEK.",
   "hl": [
    "SLOWER"
   ],
   "anchor": 8.5,
   "speed": 1.25
  },
  {
   "text": "He stared at that pen for a long time.",
   "caption": "HE STARED AT THAT PEN FOR A LONG TIME.",
   "hl": [
    "PEN"
   ],
   "anchor": 11.3,
   "speed": 1.15
  },
  {
   "text": "Then he slid it back.",
   "caption": "THEN HE SLID IT BACK.",
   "hl": [
    "BACK"
   ],
   "anchor": 13.9,
   "speed": 1.1
  },
  {
   "text": "Not yet. Not while he can still stop one.",
   "caption": "NOT YET. NOT WHILE HE CAN STILL STOP ONE.",
   "hl": [
    "STOP"
   ],
   "anchor": 15.4,
   "speed": 1.15
  },
  {
   "text": "Next morning. Seven a.m.",
   "caption": "NEXT MORNING. 7 A.M.",
   "hl": [
    "7"
   ],
   "anchor": 18.7,
   "speed": 1.1
  },
  {
   "text": "No coach. Just Teo and the rain.",
   "caption": "NO COACH. JUST TEO AND THE RAIN.",
   "hl": [
    "RAIN"
   ],
   "anchor": 20.6,
   "speed": 1.1
  },
  {
   "text": "Then someone started shooting.",
   "caption": "THEN SOMEONE STARTED SHOOTING.",
   "hl": [
    "SHOOTING"
   ],
   "anchor": 23.2,
   "speed": 1.1
  },
  {
   "text": "Charcoal kit. White streak. No contract.",
   "caption": "CHARCOAL KIT. WHITE STREAK. NO CONTRACT.",
   "hl": [
    "STREAK"
   ],
   "anchor": 25.05,
   "speed": 1.2
  },
  {
   "text": "He never retired. He just turned up early.",
   "caption": "HE NEVER RETIRED. HE JUST TURNED UP EARLY.",
   "hl": [
    "EARLY"
   ],
   "anchor": 27.5,
   "speed": 1.15
  },
  {
   "text": "Watch again. Look at what he tore off.",
   "caption": "WATCH AGAIN. LOOK AT WHAT HE TORE OFF.",
   "hl": [
    "TORE"
   ],
   "anchor": 30.1,
   "speed": 1.15
  }
 ],
