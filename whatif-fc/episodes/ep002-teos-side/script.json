 "hook": {
  "line1": "DID HE LET",
  "line2": "HIS DAD SCORE?",
  "until": 3.0,
  "pulse_at": 0.35
 },
 "lines": [
  {
   "text": "He could have stopped it.",
   "caption": "HE COULD HAVE STOPPED IT.",
   "hl": [
    "STOPPED"
   ],
   "anchor": 0.4,
   "speed": 1.15
  },
  {
   "text": "Three steps away.",
   "caption": "THREE STEPS AWAY.",
   "hl": [
    "THREE"
   ],
   "anchor": 1.55,
   "speed": 1.1
  },
  {
   "text": "Same final. His dad at the other end.",
   "caption": "SAME FINAL. HIS DAD AT THE OTHER END.",
   "hl": [
    "DAD"
   ],
   "anchor": 3.05,
   "speed": 1.15
  },
  {
   "text": "Ninety-ninth minute. One all.",
   "caption": "99TH MINUTE. 1–1.",
   "hl": [
    "99TH"
   ],
   "anchor": 5.9,
   "speed": 1.2
  },
  {
   "text": "His coach screamed one word.",
   "caption": "HIS COACH SCREAMED ONE WORD.",
   "hl": [
    "SCREAMED"
   ],
   "anchor": 7.55,
   "speed": 1.2
  },
  {
   "text": "Up.",
   "caption": "UP.",
   "hl": [
    "UP"
   ],
   "anchor": 9.0,
   "speed": 0.95
  },
  {
   "text": "First time he'd ever left his goal.",
   "caption": "FIRST TIME HE'D EVER LEFT HIS GOAL.",
   "hl": [
    "LEFT"
   ],
   "anchor": 9.8,
   "speed": 1.1
  },
  {
   "text": "And the corner dropped... into his dad's gloves.",
   "caption": "THE CORNER DROPPED INTO HIS DAD'S GLOVES.",
   "hl": [
    "DAD'S"
   ],
   "anchor": 12.1,
   "speed": 1.1
  },
  {
   "text": "Then he heard the kick.",
   "caption": "THEN HE HEARD THE KICK.",
   "hl": [
    "KICK"
   ],
   "anchor": 14.75,
   "speed": 1.1
  },
  {
   "text": "Eighty metres. Empty goal.",
   "caption": "80 METRES. EMPTY GOAL.",
   "hl": [
    "EMPTY"
   ],
   "anchor": 16.5,
   "speed": 1.05
  },
  {
   "text": "He was the fastest player on the pitch.",
   "caption": "HE WAS THE FASTEST PLAYER ON THE PITCH.",
   "hl": [
    "FASTEST"
   ],
   "anchor": 18.4,
   "speed": 1.1
  },
  {
   "text": "Three steps from the ball...",
   "caption": "THREE STEPS FROM THE BALL…",
   "hl": [
    "THREE"
   ],
   "anchor": 20.8,
   "speed": 1.05
  },
  {
   "text": "he slowed down.",
   "caption": "HE SLOWED DOWN.",
   "hl": [
    "SLOWED"
   ],
   "anchor": 22.7,
   "speed": 0.95
  },
  {
   "text": "Rain? Tired legs?",
   "caption": "RAIN? TIRED LEGS?",
   "hl": [
    "RAIN?",
    "LEGS?"
   ],
   "anchor": 24.3,
   "speed": 1.05
  },
  {
   "text": "Or a son who wanted his dad to win?",
   "caption": "OR A SON WHO WANTED HIS DAD TO WIN?",
   "hl": [
    "WIN"
   ],
   "anchor": 26.0,
   "speed": 1.05
  },
  {
   "text": "The answer's on his wrist tape. Watch again.",
   "caption": "THE ANSWER'S ON HIS WRIST TAPE. WATCH AGAIN.",
   "hl": [
    "TAPE"
   ],
   "anchor": 28.75,
   "speed": 1.15
  }
 ],
