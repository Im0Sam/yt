 "hook": {
  "line1": "HE SAVED IT.",
  "line2": "DAD WASN'T THERE.",
  "until": 2.8,
  "pulse_at": 0.35
 },
 "lines": [
  {
   "text": "He saved it.",
   "caption": "HE SAVED IT.",
   "hl": [
    "SAVED"
   ],
   "anchor": 0.38,
   "speed": 1.1
  },
  {
   "text": "And his dad wasn't there.",
   "caption": "AND HIS DAD WASN'T THERE.",
   "hl": [
    "DAD"
   ],
   "anchor": 1.3,
   "speed": 1.15
  },
  {
   "text": "Fourteen years ago. Teo's first match.",
   "caption": "14 YEARS AGO. TEO'S FIRST MATCH.",
   "hl": [
    "FIRST"
   ],
   "anchor": 2.85,
   "speed": 1.2
  },
  {
   "text": "Same night, his dad had a final of his own.",
   "caption": "SAME NIGHT, HIS DAD HAD A FINAL OF HIS OWN.",
   "hl": [
    "FINAL"
   ],
   "anchor": 5.25,
   "speed": 1.2
  },
  {
   "text": "He picked his game.",
   "caption": "HE PICKED HIS GAME.",
   "hl": [
    "PICKED"
   ],
   "anchor": 7.6,
   "speed": 1.0
  },
  {
   "text": "Last minute. Penalty.",
   "caption": "LAST MINUTE. PENALTY.",
   "hl": [
    "PENALTY"
   ],
   "anchor": 9.5,
   "speed": 1.15
  },
  {
   "text": "Teo saved it, and looked at the fence.",
   "caption": "TEO SAVED IT… AND LOOKED AT THE FENCE.",
   "hl": [
    "FENCE"
   ],
   "anchor": 12.1,
   "speed": 1.15
  },
  {
   "text": "One empty spot. Where his dad always stood.",
   "caption": "ONE EMPTY SPOT. WHERE HIS DAD ALWAYS STOOD.",
   "hl": [
    "EMPTY"
   ],
   "anchor": 14.3,
   "speed": 1.1
  },
  {
   "text": "Midnight. Teo asleep in his gloves.",
   "caption": "MIDNIGHT. TEO ASLEEP IN HIS GLOVES.",
   "hl": [
    "GLOVES"
   ],
   "anchor": 17.7,
   "speed": 1.1
  },
  {
   "text": "So he wrote his son's name on his tape.",
   "caption": "SO HE WROTE HIS SON'S NAME ON HIS TAPE.",
   "hl": [
    "NAME"
   ],
   "anchor": 20.45,
   "speed": 1.15
  },
  {
   "text": "Never played without it since.",
   "caption": "NEVER PLAYED WITHOUT IT SINCE.",
   "hl": [
    "NEVER"
   ],
   "anchor": 22.45,
   "speed": 1.15
  },
  {
   "text": "What he never knew...",
   "caption": "WHAT HE NEVER KNEW…",
   "hl": [
    "KNEW"
   ],
   "anchor": 23.75,
   "speed": 1.05
  },
  {
   "text": "Teo wrote a number on his.",
   "caption": "TEO WROTE A NUMBER ON HIS.",
   "hl": [
    "NUMBER"
   ],
   "anchor": 25.0,
   "speed": 1.1
  },
  {
   "text": "His dad's.",
   "caption": "HIS DAD'S.",
   "hl": [
    "DAD'S"
   ],
   "anchor": 26.95,
   "speed": 0.95
  },
  {
   "text": "Fourteen years later, both still wear them.",
   "caption": "14 YEARS LATER, BOTH STILL WEAR THEM.",
   "hl": [
    "BOTH"
   ],
   "anchor": 28.45,
   "speed": 1.2
  },
  {
   "text": "Watch again. Look at his hand.",
   "caption": "WATCH AGAIN. LOOK AT HIS HAND.",
   "hl": [
    "HAND"
   ],
   "anchor": 30.8,
   "speed": 1.15
  }
 ],
