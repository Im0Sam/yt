   "hl": [
    "BROKEN"
   ],
   "anchor": 1.05,
   "speed": 1.2
  },
  {
   "text": "And he just won the final.",
   "caption": "AND HE JUST WON THE FINAL.",
   "hl": [
    "FINAL"
   ],
   "anchor": 1.8,
   "speed": 1.2
  },
  {
   "text": "Ten minutes earlier...",
   "caption": "TEN MINUTES EARLIER…",
   "hl": [],
   "anchor": 3.05,
   "speed": 1.05
  },
  {
   "text": "his own coach tried to take him off.",
   "caption": "HIS OWN COACH TRIED TO TAKE HIM OFF.",
   "hl": [
    "OFF"
   ],
   "anchor": 4.3,
   "speed": 1.05
  },
  {
   "text": "He refused.",
   "caption": "HE REFUSED.",
   "hl": [
    "REFUSED"
   ],
   "anchor": 6.5,
   "speed": 1.05
  },
  {
   "text": "No keepers left on the bench.",
   "caption": "NO KEEPERS LEFT ON THE BENCH.",
   "hl": [
    "NO"
   ],
   "anchor": 7.6,
   "speed": 1.05
  },
  {
   "text": "And someone at the other end was watching.",
   "caption": "SOMEONE AT THE OTHER END WAS WATCHING.",
   "hl": [
    "WATCHING"
   ],
   "anchor": 9.6,
   "speed": 1.05
  },
  {
   "text": "Penalty. Ninety-fourth minute.",
