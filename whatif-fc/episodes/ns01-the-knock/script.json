 "lines": [
  {
   "text": "Rule one. Never open the door after 3 a.m.",
   "caption": "RULE 1: NEVER OPEN THE DOOR AFTER 3 A.M.",
   "hl": [
    "DOOR"
   ],
   "anchor": 0.35,
   "speed": 1.35
  },
  {
   "text": "You took the night shift at the Wren Motel.",
   "caption": "YOU TOOK THE NIGHT SHIFT AT THE WREN MOTEL.",
   "hl": [
    "NIGHT"
   ],
   "anchor": 2.9,
   "speed": 1.3
  },
  {
   "text": "The manager left you a list of rules.",
   "caption": "THE MANAGER LEFT YOU A LIST OF RULES.",
   "hl": [
    "RULES"
   ],
   "anchor": 5.15,
   "speed": 1.2
  },
  {
   "text": "At 2:59, the hallway lights started dying.",
   "caption": "AT 2:59, THE HALLWAY LIGHTS STARTED DYING.",
   "hl": [
    "DYING"
   ],
   "anchor": 7.55,
   "speed": 1.3
  },
  {
   "text": "Three a.m. Three knocks.",
   "caption": "3:00 A.M. THREE KNOCKS.",
   "hl": [
    "KNOCKS"
   ],
   "anchor": 10.3,
   "speed": 1.1
  },
  {
   "text": "It's me. Hale. I forgot my key.",
   "caption": "\"IT'S ME. HALE. I FORGOT MY KEY.\"",
   "hl": [
    "KEY."
   ],
   "anchor": 12.5,
   "speed": 1.0,
   "voice": "bm_lewis",
   "pitch": -3,
   "fx": "whisper",
   "fill": "#ff2b2b"
  },
  {
   "text": "The manager's voice. Exactly.",
   "caption": "THE MANAGER'S VOICE. EXACTLY.",
   "hl": [
    "EXACTLY."
   ],
   "anchor": 15.3,
   "speed": 1.3
  },
  {
   "text": "You checked the peephole.",
   "caption": "YOU CHECKED THE PEEPHOLE.",
   "hl": [
    "PEEPHOLE."
   ],
   "anchor": 16.9,
   "speed": 1.15
  },
  {
   "text": "He was at the far end of the hall,",
   "caption": "HE WAS AT THE FAR END OF THE HALL…",
   "hl": [
    "FAR"
   ],
   "anchor": 18.4,
   "speed": 1.15
  },
  {
   "text": "with his back to you.",
   "caption": "…WITH HIS BACK TO YOU.",
   "hl": [
    "BACK"
   ],
   "anchor": 20.3,
   "speed": 1.05
  },
  {
   "text": "Open the door.",
   "caption": "\"OPEN THE DOOR.\"",
   "hl": [
    "OPEN"
   ],
   "anchor": 22.3,
   "speed": 0.95,
   "voice": "bm_lewis",
   "pitch": -4,
   "fx": "whisper",
   "fill": "#ff2b2b"
  },
  {
   "text": "So. Do you open it?",
   "caption": "SO. DO YOU OPEN IT?",
   "hl": [
    "OPEN"
   ],
   "anchor": 24.4,
   "speed": 1.05
  },
  {
   "text": "Comment A or B. The most votes decides episode two.",
