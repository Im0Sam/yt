   "hl": [
    "PENALTY"
   ],
   "anchor": 12.05,
   "speed": 1.05
  },
  {
   "text": "He saves it...",
   "caption": "HE SAVES IT…",
   "hl": [
    "SAVES"
   ],
   "anchor": 14.2,
   "speed": 1.05
  },
  {
   "text": "with the one hand that still works.",
   "caption": "WITH THE ONE HAND THAT STILL WORKS.",
   "hl": [
    "ONE",
    "HAND"
   ],
   "anchor": 15.4,
   "speed": 1.05
  },
  {
   "text": "Ninety-ninth minute. Last corner.",
   "caption": "99TH MINUTE. LAST CORNER.",
   "hl": [
    "99TH"
   ],
   "anchor": 17.6,
   "speed": 1.05
  },
  {
   "text": "Their keeper's up for the corner.",
   "caption": "THEIR KEEPER'S UP FOR THE CORNER.",
